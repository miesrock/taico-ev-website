---
import { applications, purchaseTimelines } from "../../functions/lib/lead";
import { site } from "../data/site";

interface Props {
  siteKey?: string;
  source: string;
  product?: string;
  solution?: string;
  applicationContext?: string;
  pagePath: string;
  utm: Record<string, string>;
  contextLabel?: string;
}

const {
  siteKey = "",
  source,
  product = "",
  solution = "",
  applicationContext = "",
  pagePath,
  utm,
  contextLabel = "",
} = Astro.props;
---

<form
  data-lead-form
  action="/api/leads"
  method="post"
  enctype="application/x-www-form-urlencoded"
  class="glass rounded-3xl p-6 sm:p-8"
  aria-describedby="lead-form-status lead-form-note"
>
  <input type="hidden" name="submission_key" data-submission-key value="" />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="product" value={product} />
  <input type="hidden" name="solution" value={solution} />
  <input type="hidden" name="application_context" value={applicationContext} />
  <input type="hidden" name="page_path" value={pagePath} />
  <input type="hidden" name="locale" value="en" />
  <input type="hidden" name="referrer" data-referrer value="" />
  <input type="hidden" name="utm_source" value={utm.utm_source} />
  <input type="hidden" name="utm_medium" value={utm.utm_medium} />
  <input type="hidden" name="utm_campaign" value={utm.utm_campaign} />
  <input type="hidden" name="utm_content" value={utm.utm_content} />
  <input type="hidden" name="utm_term" value={utm.utm_term} />

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="lead-name" class="text-sm font-medium text-ink">Name <span class="text-wave-pink" aria-hidden="true">*</span></label>
      <input id="lead-name" name="name" required minlength="2" maxlength="80" autocomplete="name" class="mt-2 w-full rounded-2xl border border-line bg-void/40 px-4 py-3 text-ink outline-none transition focus:border-wave-cyan" />
      <p data-error-for="name" class="mt-2 text-sm text-wave-pink" role="alert"></p>
    </div>
    <div>
      <label for="lead-company" class="text-sm font-medium text-ink">Company <span class="text-wave-pink" aria-hidden="true">*</span></label>
      <input id="lead-company" name="company" required minlength="2" maxlength="120" autocomplete="organization" class="mt-2 w-full rounded-2xl border border-line bg-void/40 px-4 py-3 text-ink outline-none transition focus:border-wave-cyan" />
      <p data-error-for="company" class="mt-2 text-sm text-wave-pink" role="alert"></p>
    </div>
    <div>
      <label for="lead-email" class="text-sm font-medium text-ink">Work email <span class="text-wave-pink" aria-hidden="true">*</span></label>
      <input id="lead-email" name="email" type="email" required maxlength="254" autocomplete="email" class="mt-2 w-full rounded-2xl border border-line bg-void/40 px-4 py-3 text-ink outline-none transition focus:border-wave-cyan" />
      <p data-error-for="email" class="mt-2 text-sm text-wave-pink" role="alert"></p>
    </div>
    <div>
      <label for="lead-country" class="text-sm font-medium text-ink">Country / region <span class="text-wave-pink" aria-hidden="true">*</span></label>
      <input id="lead-country" name="country" required minlength="2" maxlength="80" autocomplete="country-name" class="mt-2 w-full rounded-2xl border border-line bg-void/40 px-4 py-3 text-ink outline-none transition focus:border-wave-cyan" />
      <p data-error-for="country" class="mt-2 text-sm text-wave-pink" role="alert"></p>
    </div>
    <div>
      <label for="lead-application" class="text-sm font-medium text-ink">Application <span class="text-wave-pink" aria-hidden="true">*</span></label>
      <select id="lead-application" name="application" required class="mt-2 w-full rounded-2xl border border-line bg-void/40 px-4 py-3 text-ink outline-none transition focus:border-wave-cyan">
        <option value="">Choose an application</option>
        {applications.map((application) => <option value={application}>{application}</option>)}
      </select>
      <p data-error-for="application" class="mt-2 text-sm text-wave-pink" role="alert"></p>
    </div>
    <div>
      <label for="lead-phone" class="text-sm font-medium text-ink">Phone / WhatsApp <span class="text-muted">(optional)</span></label>
      <input id="lead-phone" name="phone" maxlength="50" autocomplete="tel" class="mt-2 w-full rounded-2xl border border-line bg-void/40 px-4 py-3 text-ink outline-none transition focus:border-wave-cyan" />
      <p data-error-for="phone" class="mt-2 text-sm text-wave-pink" role="alert"></p>
    </div>
    <div>
      <label for="lead-timeline" class="text-sm font-medium text-ink">Purchase timeline <span class="text-muted">(optional)</span></label>
      <select id="lead-timeline" name="timeline" class="mt-2 w-full rounded-2xl border border-line bg-void/40 px-4 py-3 text-ink outline-none transition focus:border-wave-cyan">
        <option value="">Choose a timeline</option>
        {purchaseTimelines.map((timeline) => <option value={timeline}>{timeline}</option>)}
      </select>
      <p data-error-for="timeline" class="mt-2 text-sm text-wave-pink" role="alert"></p>
    </div>
  </div>

  <div class="mt-6">
    <label for="lead-requirements" class="text-sm font-medium text-ink">Requirements <span class="text-wave-pink" aria-hidden="true">*</span></label>
    <textarea id="lead-requirements" name="requirements" required minlength="20" maxlength="2000" rows="7" placeholder="Tell us about the vehicles, operating scenario, deployment location, and required configuration." class="mt-2 w-full resize-y rounded-2xl border border-line bg-void/40 px-4 py-3 text-ink outline-none transition placeholder:text-faint focus:border-wave-cyan"></textarea>
    <p data-error-for="requirements" class="mt-2 text-sm text-wave-pink" role="alert"></p>
  </div>

  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for="lead-website">Website</label>
    <input id="lead-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  {siteKey ? (
    <div class="mt-6">
      <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto"></div>
      <p class="mt-2 text-xs text-muted">This check helps protect the inquiry form from automated submissions.</p>
    </div>
  ) : (
    <p class="mt-6 rounded-2xl border border-line px-4 py-3 text-sm text-muted">Anti-spam protection is awaiting Cloudflare configuration. If the form is unavailable, email <a class="text-wave-cyan hover:underline" href={site.emailHref}>{site.email}</a> directly.</p>
  )}

  <div class="mt-6 flex items-start gap-3">
    <input id="lead-consent" name="privacyConsent" type="checkbox" value="on" required class="mt-1 h-4 w-4 accent-cyan-400" />
    <label for="lead-consent" class="text-sm leading-relaxed text-muted">I agree that TAICO EV may use this information to respond to my business inquiry. This does not subscribe me to marketing email. <span class="text-wave-pink" aria-hidden="true">*</span></label>
  </div>
  <p data-error-for="privacyConsent" class="mt-2 text-sm text-wave-pink" role="alert"></p>

  <p data-context-summary class="mt-6 rounded-2xl border border-line bg-void/20 px-4 py-3 text-sm text-muted" hidden={!contextLabel}>Context: <span class="font-medium text-ink">{contextLabel}</span></p>
  <p id="lead-form-note" class="mt-6 text-xs leading-relaxed text-faint">Required fields are marked *. We usually reply within one business day.</p>
  <p id="lead-form-status" data-lead-status aria-live="polite" class="mt-3 min-h-6 text-sm text-muted"></p>
  <button type="submit" data-lead-submit class="btn-primary mt-5 w-full sm:w-auto">Send inquiry</button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-lead-form]");
  const status = form?.querySelector<HTMLElement>("[data-lead-status]");
  const submitButton = form?.querySelector<HTMLButtonElement>("[data-lead-submit]");
  const keyInput = form?.querySelector<HTMLInputElement>("[data-submission-key]");
  const referrerInput = form?.querySelector<HTMLInputElement>("[data-referrer]");
  const contextSummary = form?.querySelector<HTMLElement>("[data-context-summary]");

  if (form && keyInput) {
    keyInput.value ||= crypto.randomUUID();
    referrerInput && (referrerInput.value = document.referrer);

    const currentUrl = new URL(window.location.href);
    const contextFields: Record<string, string> = {
      source: "source",
      product: "product",
      solution: "solution",
      application: "application_context",
      page: "page_path",
    };
    const contextLabels: string[] = [];
    for (const [queryName, fieldName] of Object.entries(contextFields)) {
      const queryValue = currentUrl.searchParams.get(queryName) || "";
      const field = form.elements.namedItem(fieldName) as HTMLInputElement | null;
      if (field && queryValue) field.value = queryValue;
      if (["product", "solution", "application"].includes(queryName) && queryValue) {
        contextLabels.push(`${queryName[0].toUpperCase()}${queryName.slice(1)}: ${queryValue}`);
      }
    }
    if (contextSummary && contextLabels.length) {
      contextSummary.textContent = `Context: ${contextLabels.join(" · ")}`;
      contextSummary.hidden = false;
    }

    const referrerUrl = (() => {
      try {
        return document.referrer ? new URL(document.referrer) : null;
      } catch {
        return null;
      }
    })();
    for (const name of ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"]) {
      const field = form.elements.namedItem(name) as HTMLInputElement | null;
      if (field && !field.value) field.value = currentUrl.searchParams.get(name) || referrerUrl?.searchParams.get(name) || "";
    }

    form.addEventListener("submit", async (event) => {
      if (!form.reportValidity()) return;
      event.preventDefault();
      if (submitButton) submitButton.disabled = true;
      if (status) status.textContent = "Sending your inquiry…";
      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((item) => (item.textContent = ""));
      form.querySelectorAll<HTMLElement>("[aria-invalid='true']").forEach((item) => item.removeAttribute("aria-invalid"));

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const payload = await response.json() as { ok?: boolean; code?: string; fields?: Record<string, string> };
        if (response.ok && payload.ok) {
          window.location.assign("/thank-you/");
          return;
        }
        const fields = payload.fields || {};
        for (const [field, message] of Object.entries(fields)) {
          const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
          const input = form.elements.namedItem(field) as HTMLElement | null;
          if (error) error.textContent = message;
          input?.setAttribute("aria-invalid", "true");
        }
        const firstField = Object.keys(fields)[0];
        const firstInput = firstField ? form.elements.namedItem(firstField) as HTMLElement | null : null;
        firstInput?.focus();
        if (status) status.textContent = fields[firstField] || (payload.code === "TURNSTILE_FAILED" ? "Please complete the anti-spam check and try again." : "We could not send the inquiry. Please try again shortly.");
      } catch {
        if (status) status.textContent = "We could not reach the inquiry service. Your entries are still here; please try again.";
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  }
</script>
