---
import { solutions } from "../data/solutions";
import { products } from "../data/products";
import { cases } from "../data/cases";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-void-2/80">
  <div class="wave-divider"></div>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3">
          <img src="/brand/taico-mark.png" alt="TAICO" class="h-6 w-auto rounded-sm" />
          <p class="font-display text-sm font-semibold tracking-[0.14em] text-ink">TAICO EV</p>
        </div>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
          Mobile EV charging and energy storage for commercial users constrained by grid,
          site, or time.
        </p>
        <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
          Powered by TAICO · Manufacturing excellence
        </p>
      </div>

      <div>
        <p class="label-tech mb-4">Solutions</p>
        <ul class="space-y-2 text-sm text-muted">
          {
            solutions.map((s) => (
              <li>
                <a class="transition hover:text-wave-cyan" href={`/solutions/${s.slug}/`}>
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-tech mb-4">Products</p>
        <ul class="space-y-2 text-sm text-muted">
          {
            products.map((p) => (
              <li>
                <a class="transition hover:text-wave-cyan" href={`/products/${p.slug}/`}>
                  {p.model}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-tech mb-4">Cases</p>
        <ul class="space-y-2 text-sm text-muted">
          {
            cases.map((c) => (
              <li>
                <a class="transition hover:text-wave-cyan" href={`/cases/${c.slug}/`}>
                  {c.eyebrow.replace(/^Case \d+ · /, "")}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-tech mb-4">Signal</p>
        <p class="text-sm text-muted">
          <a class="transition hover:text-wave-cyan" href="https://taicoev.com">taicoev.com</a>
        </p>
        <p class="mt-2 text-sm text-muted">
          <a class="transition hover:text-wave-cyan" href="mailto:hello@taicoev.com">
            hello@taicoev.com
          </a>
        </p>
      </div>
    </div>

    <p class="mt-10 border-t border-line pt-6 font-mono text-[11px] text-faint">
      © {year} TAICO EV · Analogue Waves interface · Content evolving
    </p>
  </div>
</footer>
