---
import CtaBand from "../components/CtaBand.astro";
import WaveField from "../components/WaveField.astro";
import Layout from "../layouts/Layout.astro";
import { getPublishedFamilies } from "../data/families";
import { getPublishedProducts, type Product } from "../data/products";
import { getApplicationForSolution, solutions } from "../data/solutions";

const solutionEntries = solutions.map((presentation) => ({
  presentation,
  application: getApplicationForSolution(presentation),
}));

const featuredProducts = getPublishedFamilies()
  .map((family) => getPublishedProducts().find((product) => product.category === family.slug))
  .filter((product): product is Product => Boolean(product));
---

<Layout>
  <section class="relative overflow-hidden">
    <WaveField intensity="high" />
    <div class="section-pad relative z-10 !pt-24 !pb-28 sm:!pt-28 sm:!pb-32">
      <p class="label-tech">TAICO EV · Mobile energy storage charging</p>
      <h1 class="font-display mt-6 max-w-4xl text-4xl font-semibold leading-tight tracking-wide sm:text-5xl lg:text-6xl"><span class="text-gradient">Power electric mobility</span><br />beyond the grid.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">TAICO EV provides mobile and stationary energy storage charging systems for emergency EV charging, on-demand service, engineering power, and PV-ESS charging applications.</p>
      <div class="mt-10 flex flex-wrap gap-3"><a class="btn-primary" href="#solutions">Find your solution</a><a class="btn-ghost" href="/contact/">Talk to a specialist</a></div>
      <div class="mt-14 grid max-w-4xl gap-3 sm:grid-cols-4">
        {solutionEntries.map((item, index) => <a href={`/solutions/${item.presentation.slug}/`} class="glass glass-hover rounded-2xl px-4 py-3"><p class="font-mono text-[10px] uppercase tracking-[0.2em] text-wave-cyan">CH-{String(index + 1).padStart(2, "0")}</p><p class="mt-1 text-sm font-medium text-ink">{item.application.title}</p></a>)}
      </div>
    </div>
  </section>

  <div class="wave-divider"></div>

  <section class="section-pad">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div><p class="label-tech">Energy constraints</p><h2 class="font-display mt-4 text-3xl font-semibold tracking-wide text-ink">Deploy charging capacity where the operation needs it.</h2><p class="mt-4 text-muted leading-relaxed">The TKMC range combines energy storage, DC charging, and selected AC or PV-storage capabilities across mobile and stationary deployment formats.</p></div>
      <ul class="grid gap-3 sm:grid-cols-2">{["Charging away from fixed bays", "Changing operating locations", "Temporary and engineering power", "PV-storage charging deployment"].map((item) => <li class="glass rounded-2xl px-4 py-5 text-sm text-ink">{item}</li>)}</ul>
    </div>
  </section>

  <section id="solutions" class="section-pad !pt-0">
    <p class="label-tech">Product exploration</p>
    <h2 class="font-display mt-4 max-w-3xl text-3xl font-semibold tracking-wide text-ink">Start with the operating challenge.</h2>
    <p class="mt-3 max-w-2xl text-muted">Choose the scenario closest to your deployment. We will show the catalog-supported product starting points, then confirm the final configuration with you.</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {solutionEntries.map((item) => <a href={`/solutions/${item.presentation.slug}/`} class="glass glass-hover group flex min-h-64 flex-col rounded-3xl p-6"><p class="font-mono text-[11px] uppercase tracking-[0.16em] text-wave-violet">{item.presentation.eyebrow}</p><h3 class="mt-4 text-xl font-semibold text-ink group-hover:text-wave-cyan">{item.application.title}</h3><p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{item.application.summary}</p><span class="mt-6 text-sm font-semibold text-wave-cyan">Explore solution →</span></a>)}
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="label-tech">TKMC range</p><h2 class="font-display mt-4 text-3xl font-semibold tracking-wide text-ink">Four deployment formats.</h2><p class="mt-3 max-w-2xl text-muted">Explore one representative product from each catalog category, then compare the full range.</p></div><a href="/products/" class="btn-ghost text-xs">View all products</a></div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">{featuredProducts.map((product) => <a href={`/products/${product.slug}/`} class="glass glass-hover group overflow-hidden rounded-3xl"><div class="aspect-[16/10] bg-void-2 p-3"><img src={product.hero} alt={`${product.model} product`} class="h-full w-full object-contain" loading="lazy" /></div><div class="p-5"><p class="font-mono text-xs text-wave-cyan">{product.model}</p><h3 class="mt-2 text-sm font-semibold text-ink group-hover:text-wave-cyan">{product.productType}</h3><p class="mt-3 text-sm text-muted">{product.capacityKwh} kWh · {product.outputPowerKw} kW</p></div></a>)}</div>
  </section>

  <div id="contact"><CtaBand /></div>
</Layout>
