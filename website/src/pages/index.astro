---
import Layout from "../layouts/Layout.astro";
import WaveField from "../components/WaveField.astro";
import CtaBand from "../components/CtaBand.astro";
import { solutions } from "../data/solutions";
import { products } from "../data/products";
import { cases } from "../data/cases";

const stack = [
  { k: "Battery Storage", d: "Buffer peak demand without waiting for grid works." },
  { k: "Fast Charging", d: "Deliver energy where vehicles actually operate." },
  { k: "Flexible Deploy", d: "Move capacity across sites, events, and shifts." },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <WaveField intensity="high" />
    <div class="section-pad relative z-10 !pt-24 !pb-28 sm:!pt-28 sm:!pb-32">
      <p class="label-tech">TAICO EV · Mobile energy protocol</p>
      <h1
        class="font-display mt-6 max-w-4xl text-4xl font-semibold leading-tight tracking-wide sm:text-5xl lg:text-6xl"
      >
        <span class="text-gradient">Power Electric Mobility</span>
        <br />
        <span class="text-ink">Beyond the Grid.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        Mobile EV charging and energy storage for dealerships, fleets, commercial properties,
        and industrial sites constrained by infrastructure.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a class="btn-primary" href="#solutions">Find Your Solution</a>
        <a class="btn-ghost" href="#contact">Talk to a Specialist</a>
      </div>

      <div class="mt-14 grid max-w-3xl gap-3 sm:grid-cols-3">
        {
          ["Dealers", "Roadside", "Commercial"].map((t, i) => (
            <div class="glass rounded-2xl px-4 py-3">
              <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-wave-cyan">
                CH-{String(i + 1).padStart(2, "0")}
              </p>
              <p class="mt-1 text-sm font-medium text-ink">{t}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="wave-divider"></div>

  <!-- Constraints -->
  <section class="section-pad">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div>
        <p class="label-tech">Signal noise · Infrastructure lag</p>
        <h2 class="font-display mt-4 text-3xl font-semibold tracking-wide text-ink">
          Fixed charging cannot keep pace with electric mobility.
        </h2>
        <p class="mt-4 text-muted leading-relaxed">
          Grid capacity, permitting, civil works, and site constraints slow deployment —
          while vehicles, guests, and fleets need energy now.
        </p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          [
            "Limited grid capacity",
            "Slow installation cycles",
            "High infrastructure cost",
            "Temporary & remote demand",
          ].map((item) => (
            <li class="glass glass-hover rounded-2xl px-4 py-5 text-sm text-ink">{item}</li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 glass relative overflow-hidden rounded-3xl p-6 sm:p-8">
      <p class="label-tech">Composition</p>
      <p class="mt-3 font-display text-xl tracking-wide text-ink sm:text-2xl">
        Battery Storage <span class="text-wave-cyan">+</span> Fast Charging
        <span class="text-wave-violet"> +</span> Flexible Deployment
      </p>
      <p class="mt-2 text-sm text-muted">= Charging capacity where it is needed.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          stack.map((s) => (
            <div class="rounded-2xl border border-line bg-void/40 p-4">
              <p class="text-sm font-semibold text-wave-cyan">{s.k}</p>
              <p class="mt-2 text-sm text-muted">{s.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Solutions -->
  <section id="solutions" class="relative">
    <div class="section-pad">
      <p class="label-tech">Solutions · First wave</p>
      <h2 class="font-display mt-4 text-3xl font-semibold tracking-wide text-ink sm:text-4xl">
        Start from the operating problem.
      </h2>
      <p class="mt-3 max-w-2xl text-muted">
        Navigation prioritizes scenarios over model numbers — the way commercial buyers actually buy.
      </p>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          solutions.map((s, i) => (
            <a
              href={`/solutions/${s.slug}/`}
              class="glass glass-hover group flex flex-col rounded-3xl p-6"
            >
              <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-wave-violet">
                {String(i + 1).padStart(2, "0")}
              </p>
              <h3 class="mt-4 text-xl font-semibold text-ink transition group-hover:text-wave-cyan">
                {s.title}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.summary}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-wave-cyan">
                Open solution
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="wave-divider"></div>

  <!-- Products -->
  <section id="products" class="section-pad">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="label-tech">Capability layers</p>
        <h2 class="font-display mt-4 text-3xl font-semibold tracking-wide text-ink">
          Products as solution tiers
        </h2>
        <p class="mt-3 max-w-2xl text-muted">
          Three hardware tiers under the TAICO EV brand — from portable lot charging to commercial energy hubs.
        </p>
      </div>
      <a href="/products/" class="btn-ghost text-xs">View all products</a>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        products.map((p) => (
          <a
            href={`/products/${p.slug}/`}
            class="glass glass-hover group overflow-hidden rounded-3xl"
          >
            <div class="aspect-[16/10] overflow-hidden bg-void-2">
              <img
                src={p.hero}
                alt={p.title}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-wave-violet">
                {p.tier}
              </p>
              <p class="mt-2 font-semibold text-ink group-hover:text-wave-cyan">{p.model}</p>
              <p class="mt-1 text-sm text-muted">{p.title}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Cases -->
  <section id="cases" class="section-pad !pt-0">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="label-tech">Case studies</p>
        <h2 class="font-display mt-4 text-3xl font-semibold tracking-wide text-ink">
          Trust assets, not decoration.
        </h2>
        <p class="mt-3 max-w-2xl text-muted">
          Field applications with customer type, region, problem, equipment, and operational outcomes — no invented conversion rates.
        </p>
      </div>
      <a href="/cases/" class="btn-ghost text-xs">All cases</a>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        cases.slice(0, 4).map((c) => (
          <a
            href={`/cases/${c.slug}/`}
            class="glass glass-hover group overflow-hidden rounded-3xl"
          >
            <div class="aspect-[16/9] overflow-hidden bg-void-2">
              <img
                src={c.hero}
                alt={c.title}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-wave-violet">
                {c.eyebrow}
              </p>
              <h3 class="mt-2 font-semibold text-ink group-hover:text-wave-cyan">{c.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-muted">{c.summary}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section id="company" class="section-pad !pt-0">
    <div class="glass rounded-3xl p-6 sm:p-8">
      <p class="label-tech">Company</p>
      <h2 class="font-display mt-4 text-2xl font-semibold tracking-wide text-ink">
        TAICO EV
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        Independent EV energy solutions brand for overseas markets — backed by TAICO manufacturing
        depth and OEM technology partners.
      </p>
    </div>
  </section>

  <div id="contact">
    <CtaBand />
  </div>
</Layout>
