---
import { getCollection } from "astro:content";
import CtaBand from "../../../components/CtaBand.astro";
import WaveField from "../../../components/WaveField.astro";
import Layout from "../../../layouts/Layout.astro";
import { getApplication } from "../../../data/applications";
import { getProductFamily, getPublishedFamilies } from "../../../data/families";
import {
  getFamilyComparison,
  getFamilyHref,
  getFamilyProducts,
  getFamilyRanges,
  getFamilySelector,
  getFamilyStructuredData,
  getApplicationHref,
  knowledgeRelatesToFamily,
} from "../../../lib/content";

export function getStaticPaths() {
  return getPublishedFamilies().map((family) => ({ params: { slug: family.slug } }));
}

const family = getProductFamily(Astro.params.slug!);
if (!family) throw new Error(`Unknown product family: ${Astro.params.slug}`);

const products = getFamilyProducts(family.slug);
const ranges = getFamilyRanges(family, products);
const comparison = getFamilyComparison(family, products);
const selector = getFamilySelector(family);
const useCases = family.useCases.map((useCase) => {
  const application = useCase.applicationSlug ? getApplication(useCase.applicationSlug) : undefined;
  if (useCase.applicationSlug && !application) {
    throw new Error(`Unknown application "${useCase.applicationSlug}" on family "${family.slug}"`);
  }
  return { useCase, application };
});
const rangeItems = [
  ranges.capacityKwh && { label: "Capacity", value: ranges.capacityKwh },
  ranges.outputPowerKw && { label: "Output power", value: ranges.outputPowerKw },
  ranges.voltage && { label: "Voltage", value: ranges.voltage },
  ranges.connector && { label: "Connector", value: ranges.connector },
].filter((item): item is { label: string; value: string } => Boolean(item));
const relatedKnowledge = (await getCollection("articles"))
  .filter((article) => knowledgeRelatesToFamily(article.data, family.slug))
  .sort((a, b) => a.data.order - b.data.order);
const structuredData = getFamilyStructuredData(family, Astro.site ?? "https://taicoev.com", products);
const familyPath = getFamilyHref(family.slug);
---

<Layout title={family.seo.title} description={family.seo.description} canonicalPath={familyPath}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="relative overflow-hidden">
    <WaveField intensity="low" />
    <div class="section-pad relative z-10 !pt-12 !pb-12 sm:!pt-16">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-faint">
          <li><a href="/" class="transition hover:text-wave-cyan">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/products/" class="transition hover:text-wave-cyan">Products</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-wave-cyan" aria-current="page">{family.title}</li>
        </ol>
      </nav>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-[0.42fr_0.58fr] lg:gap-12">
        <div>
          <p class="label-tech">Product family</p>
          <h1 class="font-display mt-4 text-4xl font-semibold tracking-wide text-ink">{family.title}</h1>
          <p class="mt-4 max-w-xl leading-relaxed text-muted">{family.description}</p>
        </div>
        {
          family.visual && (
            <figure class="glass overflow-hidden rounded-3xl">
              <img
                src={family.visual.src}
                alt={family.visual.alt}
                width="1280"
                height="720"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="aspect-[16/10] h-auto w-full object-cover object-center sm:aspect-[16/9]"
              />
              <figcaption class="border-t border-line px-5 py-3 font-mono text-[11px] uppercase tracking-[0.14em] text-faint">{family.visual.caption}</figcaption>
            </figure>
          )
        }
      </div>
    </div>
  </section>

  {
    rangeItems.length > 0 && (
      <section class="section-pad !pt-0 !pb-12">
        <p class="label-tech">Published range</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {rangeItems.map((item) => (
            <article class="glass rounded-3xl p-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-wave-violet">{item.label}</p>
              <p class="mt-3 font-mono text-lg text-wave-cyan">{item.value}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <section class="section-pad !pt-0">
    <div class="max-w-3xl">
      <p class="label-tech">Family overview</p>
      <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink sm:text-3xl">{family.overview.headline}</h2>
      <p class="mt-4 text-sm leading-relaxed text-muted">{family.overview.body}</p>
    </div>
  </section>

  {
    useCases.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Use cases</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Where this family is used.</h2>
        <div class="mt-7 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {useCases.map(({ useCase, application }) => (
            <article class="glass rounded-3xl p-5">
              <h3 class="text-lg font-semibold text-ink">{useCase.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{useCase.description}</p>
              {application && (
                <a href={getApplicationHref(application)} class="mt-4 inline-block text-sm font-semibold text-wave-cyan">
                  View {application.title} →
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    family.selectionGuide.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">How to choose</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Selection criteria for this family.</h2>
        <div class="mt-7 grid gap-4 md:grid-cols-2">
          {family.selectionGuide.map((item, index) => (
            <article class="glass rounded-3xl p-5">
              <p class="font-mono text-xs text-wave-violet">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="mt-3 text-base font-semibold text-ink">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    comparison.rows.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Product comparison</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Compare published models.</h2>
        <div class="glass mt-7 overflow-x-auto rounded-3xl">
          <table class="w-full min-w-[720px] text-left text-sm">
            <thead class="border-b border-line bg-void/30 text-muted">
              <tr>
                <th class="px-6 py-4 font-medium">Model</th>
                {comparison.fields.map((field) => <th class="px-6 py-4 font-medium">{field.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {comparison.rows.map((row, index) => (
                <tr class:list={[index % 2 === 0 ? "bg-void/20" : "bg-transparent"]}>
                  <td class="px-6 py-4 font-mono text-wave-cyan">
                    <a href={`/products/${row.product.slug}/`} class="hover:underline">{row.product.model}</a>
                  </td>
                  {comparison.fields.map((field) => <td class="px-6 py-4 text-ink">{row.values[field.field]}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    selector.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Starting points</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Which product should you start with?</h2>
        <div class="mt-7 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {selector.map(({ useCase, product, application }) => (
            <article class="glass rounded-3xl p-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-wave-violet">{useCase.title}</p>
              <p class="mt-3 text-sm text-muted">{useCase.description}</p>
              <a href={`/products/${product.slug}/`} class="mt-5 flex items-center justify-between gap-3 rounded-2xl border border-line px-4 py-3 transition hover:border-line-strong">
                <span>
                  <span class="block font-mono text-xs text-wave-cyan">{product.model}</span>
                  <span class="mt-1 block text-sm font-semibold text-ink">{product.capacityKwh} kWh · {product.outputPowerKw} kW</span>
                </span>
                <span class="text-wave-cyan" aria-hidden="true">→</span>
              </a>
              {application && <a href={getApplicationHref(application)} class="mt-3 inline-block text-xs font-semibold text-wave-cyan">Related solution →</a>}
            </article>
          ))}
        </div>
      </section>
    )
  }

  <section class="section-pad !pt-0">
    <p class="label-tech">Products in this family</p>
    <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Published catalog models.</h2>
    <div class="mt-7 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        products.map((product) => (
          <a href={`/products/${product.slug}/`} class="glass glass-hover group flex flex-col overflow-hidden rounded-3xl">
            <div class="aspect-[16/10] bg-void-2 p-3">
              <img src={product.hero} alt={`${product.model} product`} class="h-full w-full object-contain" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="font-mono text-[11px] text-wave-violet">{product.model}</p>
              <h2 class="mt-2 text-lg font-semibold text-ink transition group-hover:text-wave-cyan">{product.productType}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{product.summary}</p>
              <p class="mt-5 font-mono text-sm text-wave-cyan">{product.capacityKwh} kWh · {product.outputPowerKw} kW</p>
              <span class="mt-5 text-sm font-semibold text-wave-cyan">View specifications →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {
    relatedKnowledge.length > 0 && (
      <section class="section-pad !pt-0">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="label-tech">Related knowledge</p>
            <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Read before comparing models.</h2>
          </div>
          <a href="/resources/articles/" class="btn-ghost text-xs">All articles</a>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedKnowledge.map((article) => (
            <article class="glass glass-hover rounded-2xl p-5">
              <p class="label-tech">{article.data.eyebrow}</p>
              <h3 class="mt-3 font-semibold text-ink">
                <a href={`/resources/articles/${article.id}/`} class="transition hover:text-wave-cyan">{article.data.title}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{article.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    family.faq && family.faq.length > 0 && (
      <section id="faq" class="scroll-mt-24 section-pad !pt-0">
        <p class="label-tech">FAQ</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Buying questions for this family.</h2>
        <div class="mt-6 max-w-4xl space-y-3">
          {family.faq.map((item) => (
            <details class="glass rounded-2xl px-5 py-4">
              <summary class="cursor-pointer list-none pr-6 font-semibold text-ink marker:hidden">{item.question}</summary>
              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }

  <CtaBand title={`Need help choosing a ${family.title.toLowerCase()} model?`} body="Share your operating scenario, capacity, and output requirements. The TAICO EV team will help identify a starting configuration." />
</Layout>
