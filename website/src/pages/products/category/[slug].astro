---
import CtaBand from "../../../components/CtaBand.astro";
import WaveField from "../../../components/WaveField.astro";
import Layout from "../../../layouts/Layout.astro";
import { getPublishedProducts, productCategories } from "../../../data/products";

export function getStaticPaths() {
  return productCategories.map((category) => ({ params: { slug: category.slug } }));
}

const category = productCategories.find((item) => item.slug === Astro.params.slug);
if (!category) throw new Error(`Unknown product category: ${Astro.params.slug}`);
const products = getPublishedProducts().filter((product) => product.category === category.slug);
---

<Layout title={`${category.title} | Products | TAICO EV`} description={category.description}>
  <section class="relative overflow-hidden">
    <WaveField intensity="mid" />
    <div class="section-pad relative z-10 !pt-16 !pb-12">
      <a href="/products/" class="font-mono text-xs uppercase tracking-[0.18em] text-faint transition hover:text-wave-cyan">← All products</a>
      <p class="label-tech mt-8">Product category</p>
      <h1 class="font-display mt-4 max-w-3xl text-4xl font-semibold tracking-wide text-ink">{category.title}</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">{category.description}</p>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        products.map((product) => (
          <a href={`/products/${product.slug}/`} class="glass glass-hover group flex flex-col overflow-hidden rounded-3xl">
            <div class="aspect-[16/10] bg-void-2 p-3">
              <img src={product.hero} alt={`${product.model} product`} class="h-full w-full object-contain" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="font-mono text-[11px] text-wave-violet">{product.model}</p>
              <h2 class="mt-2 text-lg font-semibold text-ink transition group-hover:text-wave-cyan">{product.productType}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{product.summary}</p>
              <p class="mt-5 font-mono text-sm text-wave-cyan">{product.capacityKwh} kWh · {product.outputPowerKw} kW</p>
              <span class="mt-5 text-sm font-semibold text-wave-cyan">View specifications →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand source="product-category" pagePath={Astro.url.pathname} title={`Need help choosing a ${category.title.toLowerCase()} model?`} body="Share your operating scenario, capacity, and output requirements. The TAICO EV team will help identify a starting configuration." />
</Layout>
