---
import { getCollection } from "astro:content";
import CtaBand from "../../components/CtaBand.astro";
import PageHero from "../../components/PageHero.astro";
import Layout from "../../layouts/Layout.astro";
import { getProduct, getProductSeo, getProductSpecs, getProductStructuredData, getPublishedProducts } from "../../data/products";
import { getApplicationForSolution } from "../../data/solutions";
import {
  getApplicationHref,
  getApplicationsForProduct,
  getFamilyForProduct,
  getProductCompatibility,
  getSiblingProducts,
  getSolutionsForProduct,
  knowledgeRelatesToProduct,
} from "../../lib/content";

export function getStaticPaths() {
  return getPublishedProducts().map((product) => ({ params: { slug: product.slug } }));
}

const product = getProduct(Astro.params.slug!);
if (!product) throw new Error(`Unknown product: ${Astro.params.slug}`);

const specifications = getProductSpecs(product);
const seo = getProductSeo(product);
const structuredData = getProductStructuredData(product, Astro.site ?? "https://taicoev.com");
const family = getFamilyForProduct(product);
const relatedSolutions = getSolutionsForProduct(product).map((presentation) => ({
  presentation,
  application: getApplicationForSolution(presentation),
}));
const relatedApplications = getApplicationsForProduct(product);
const relatedProducts = getSiblingProducts(product);
const compatibility = getProductCompatibility(product);
const relatedKnowledge = (await getCollection("articles"))
  .filter((article) => knowledgeRelatesToProduct(article.data, product.slug) || article.data.relatedFamilies.includes(product.category))
  .sort((a, b) => a.data.order - b.data.order);
const pageHero = relatedSolutions[0]?.presentation.visual ?? family.visual;
if (!pageHero) throw new Error(`Product ${product.slug} is missing a scene hero visual`);
---

<Layout title={seo.title} description={seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <PageHero
    src={pageHero.src}
    alt={pageHero.alt}
    caption={`TAICO MC 2026 Catalog v${product.catalogSource.version} · Page ${product.catalogSource.page}`}
    align={pageHero.align}
  >
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-white/55">
        <li><a href="/" class="transition hover:text-white">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/products/" class="transition hover:text-white">Products</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/products/category/${family.slug}/`} class="transition hover:text-white">{family.title}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-wave-cyan" aria-current="page">{product.model}</li>
      </ol>
    </nav>
    <a href={`/products/category/${family.slug}/`} class="label-tech mt-5 inline-block transition hover:text-white">{family.title} →</a>
    <p class="mt-4 font-mono text-sm text-white/80">{product.model}</p>
    <h1 class="font-display mt-2 text-2xl font-semibold leading-tight tracking-wide text-white sm:text-4xl">{product.productType}</h1>
    <p class="mt-4 hidden max-w-md text-sm leading-relaxed text-white/75 lg:block">{product.summary}</p>
    <p class="mt-5 font-mono text-lg text-wave-cyan">{product.capacityKwh} kWh · {product.outputPowerKw} kW</p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a class="btn-primary !px-4 !py-2 text-xs" href="/contact/">Request configuration</a>
      <a class="btn-hero-ghost !px-4 !py-2 text-xs" href="#specifications">View specifications</a>
    </div>
  </PageHero>

  <section class="section-pad !py-12">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="glass rounded-3xl p-6">
        <p class="label-tech">Why this product</p>
        <ul class="mt-4 space-y-3">
          {product.capabilities.map((capability) => <li class="flex gap-3 text-sm text-muted"><span class="font-mono text-wave-mint">+</span>{capability}</li>)}
        </ul>
      </div>
      <div class="glass rounded-3xl p-6">
        <p class="label-tech">Who it is for</p>
        <ul class="mt-4 space-y-3">
          {relatedApplications.map((application) => (
            <li>
              <a href={getApplicationHref(application)} class="flex gap-3 text-sm text-muted transition hover:text-wave-cyan">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-wave-cyan"></span>
                {application.title}
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-4 space-y-3 border-t border-line pt-4">
          {product.catalogApplications.map((application) => <li class="flex gap-3 text-sm text-muted"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-wave-violet"></span>{application}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="specifications" class="scroll-mt-24 section-pad !pt-0">
    <div class="glass overflow-hidden rounded-3xl">
      <div class="border-b border-line px-6 py-5 sm:px-8">
        <p class="label-tech">Catalog specification</p>
        <h2 class="font-display mt-2 text-2xl font-semibold tracking-wide text-ink">Technical details</h2>
        <p class="mt-3 text-sm text-muted">Published from TAICO MC 2026 Catalog v{product.catalogSource.version}, page {product.catalogSource.page}.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[520px] text-left text-sm">
          <tbody>
            {specifications.map((specification, index) => <tr class:list={[index % 2 === 0 ? "bg-void/30" : "bg-transparent"]}><th class="w-[42%] px-6 py-3 font-medium text-muted sm:px-8">{specification.label}</th><td class="px-6 py-3 text-ink sm:px-8">{specification.value}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <p class="label-tech">Catalog product photography</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Published product view</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">This catalog image shows {product.model} as published in TAICO MC 2026 Catalog v{product.catalogSource.version}. Final configuration must be confirmed for the project.</p>
      </div>
      <figure class="glass overflow-hidden rounded-3xl p-3"><img src={product.hero} alt={`${product.model} from the TAICO product catalog`} class="h-auto w-full rounded-2xl object-contain" loading="lazy" /></figure>
    </div>
  </section>

  {
    family.selectionGuide.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">How to choose</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Selection criteria in this family.</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {family.selectionGuide.map((item) => (
            <article class="glass rounded-2xl p-5">
              <h3 class="text-sm font-semibold text-ink">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    compatibility.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Compatibility / configuration</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Published interface and operating fields.</h2>
        <div class="glass mt-6 overflow-hidden rounded-3xl">
          <table class="w-full min-w-[480px] text-left text-sm">
            <tbody>
              {compatibility.map((item, index) => (
                <tr class:list={[index % 2 === 0 ? "bg-void/30" : "bg-transparent"]}>
                  <th class="w-[42%] px-6 py-3 font-medium text-muted sm:px-8">{item.label}</th>
                  <td class="px-6 py-3 text-ink sm:px-8">{item.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    relatedSolutions.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Explore by challenge</p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {relatedSolutions.map((item) => <a href={`/solutions/${item.presentation.slug}/`} class="glass glass-hover rounded-2xl p-5"><h2 class="font-semibold text-ink">{item.application.title}</h2><p class="mt-2 text-sm text-muted">{item.presentation.headline}</p></a>)}
        </div>
      </section>
    )
  }

  {
    relatedProducts.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Related products</p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {relatedProducts.map((item) => <a href={`/products/${item.slug}/`} class="glass glass-hover flex gap-4 rounded-2xl p-4"><img src={item.hero} alt="" class="h-20 w-24 shrink-0 rounded-xl object-contain" loading="lazy" /><div><p class="font-mono text-xs text-wave-cyan">{item.model}</p><h2 class="mt-1 text-sm font-semibold text-ink">{item.productType}</h2><p class="mt-1 text-xs text-muted">{item.capacityKwh} kWh · {item.outputPowerKw} kW</p></div></a>)}
        </div>
      </section>
    )
  }

  {
    relatedKnowledge.length > 0 && (
      <section class="section-pad !pt-0">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="label-tech">Related knowledge</p>
            <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Read the supporting guides.</h2>
          </div>
          <a href="/resources/articles/" class="btn-ghost text-xs">All articles</a>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedKnowledge.map((article) => (
            <article class="glass glass-hover rounded-2xl p-5">
              <p class="label-tech">{article.data.eyebrow}</p>
              <h3 class="mt-3 font-semibold text-ink">
                <a href={`/resources/articles/${article.id}/`} class="transition hover:text-wave-cyan">{article.data.title}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{article.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    family.faq && family.faq.length > 0 && (
      <section id="faq" class="scroll-mt-24 section-pad !pt-0">
        <p class="label-tech">FAQ</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Questions for this product family.</h2>
        <div class="mt-6 max-w-4xl space-y-3">
          {family.faq.map((item) => (
            <details class="glass rounded-2xl px-5 py-4">
              <summary class="cursor-pointer list-none pr-6 font-semibold text-ink marker:hidden">{item.question}</summary>
              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }

  <section class="section-pad !pt-0">
    <div class="glass rounded-3xl p-6">
      <p class="label-tech">Evidence / documentation</p>
      <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Catalog source</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        Published specifications for {product.model} are transcribed from TAICO MC 2026 Catalog v{product.catalogSource.version}, page {product.catalogSource.page}. Request current project documentation for a configuration review.
      </p>
      <a href="/resources/#technical-documentation" class="btn-ghost mt-5 text-xs">Request documentation</a>
    </div>
  </section>

  <div id="contact"><CtaBand title={`Configure ${product.model} for your project`} body="Share your vehicle, charging, power, and deployment requirements with the TAICO EV team." /></div>
</Layout>
