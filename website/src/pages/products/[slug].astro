---
import Layout from "../../layouts/Layout.astro";
import WaveField from "../../components/WaveField.astro";
import CtaBand from "../../components/CtaBand.astro";
import { products, getProduct } from "../../data/products";
import { solutions } from "../../data/solutions";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProduct(slug!);

if (!product) {
  throw new Error(`Unknown product: ${slug}`);
}

const others = products.filter((p) => p.slug !== product.slug);
const related = solutions.filter((s) => product.relatedSolutions.includes(s.slug));
---

<Layout title={`${product.model} · ${product.title} | TAICO EV`} description={product.summary}>
  <section class="relative overflow-hidden">
    <WaveField intensity="mid" />
    <div class="section-pad relative z-10 !pt-16 !pb-10">
      <a
        href="/#products"
        class="font-mono text-xs uppercase tracking-[0.18em] text-faint transition hover:text-wave-cyan"
      >
        ← All products
      </a>

      <div class="mt-8 grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="label-tech">{product.tier}</p>
          <p class="mt-3 font-mono text-sm text-wave-violet">{product.model}</p>
          <h1 class="font-display mt-2 text-3xl font-semibold tracking-wide text-ink sm:text-4xl">
            <span class="text-gradient">{product.title}</span>
          </h1>
          <p class="mt-4 text-lg text-ink/90">{product.headline}</p>
          <p class="mt-4 text-muted leading-relaxed">{product.summary}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn-primary" href="#contact">Request configuration</a>
            <a class="btn-ghost" href="#specs">View specifications</a>
          </div>
          <div class="mt-6 flex items-center gap-3">
            <img
              src="/brand/taico-mark.png"
              alt="TAICO"
              class="h-6 w-auto rounded-sm"
              width="120"
              height="36"
            />
            <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
              TAICO EV branded platform
            </span>
          </div>
        </div>

        <div class="glass overflow-hidden rounded-3xl p-2">
          <img
            src={product.hero}
            alt={`${product.model} product visualization`}
            class="h-auto w-full rounded-2xl object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="wave-divider"></div>

  <section class="section-pad !py-14">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="glass rounded-3xl p-6">
        <p class="label-tech">Best for</p>
        <ul class="mt-4 space-y-3">
          {
            product.bestFor.map((item) => (
              <li class="flex gap-3 text-sm text-muted">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-wave-cyan" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="glass rounded-3xl p-6 lg:col-span-2">
        <p class="label-tech">Problems it solves</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-3">
          {
            product.solves.map((item) => (
              <li class="rounded-2xl border border-line bg-void/40 px-4 py-4 text-sm text-ink">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <p class="label-tech">Capability</p>
    <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">
      Built for commercial operations
    </h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        product.features.map((f, i) => (
          <div class="glass rounded-2xl px-5 py-4">
            <span class="font-mono text-xs text-wave-violet">
              {String(i + 1).padStart(2, "0")}
            </span>
            <p class="mt-2 text-sm text-ink">{f}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    product.gallery && product.gallery.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Visuals</p>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {product.gallery.map((src) => (
            <div class="glass overflow-hidden rounded-2xl p-2">
              <img
                src={src}
                alt={`${product.model} additional view`}
                class="h-auto w-full rounded-xl object-cover"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section id="specs" class="section-pad !pt-0">
    <div class="glass overflow-hidden rounded-3xl">
      <div class="border-b border-line px-6 py-5 sm:px-8">
        <p class="label-tech">Technical baseline</p>
        <h2 class="font-display mt-2 text-2xl font-semibold tracking-wide text-ink">
          Specifications
        </h2>
        {
          product.note && (
            <p class="mt-3 max-w-3xl text-sm text-muted">{product.note}</p>
          )
        }
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[520px] text-left text-sm">
          <tbody>
            {
              product.specs.map((row, i) => (
                <tr class:list={[i % 2 === 0 ? "bg-void/30" : "bg-transparent"]}>
                  <th class="w-[40%] px-6 py-3 font-medium text-muted sm:px-8">{row.label}</th>
                  <td class="px-6 py-3 text-ink sm:px-8">{row.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="border-t border-line px-6 py-5 sm:px-8">
        <p class="label-tech mb-3">Connector options</p>
        <div class="flex flex-wrap gap-2">
          {
            product.connectors.map((c) => (
              <span class="rounded-full border border-line-strong px-3 py-1 font-mono text-xs text-wave-cyan">
                {c}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Pair with solutions</p>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {related.map((s) => (
            <a href={`/solutions/${s.slug}/`} class="glass glass-hover rounded-2xl p-5">
              <h3 class="font-semibold text-ink">{s.title}</h3>
              <p class="mt-2 text-sm text-muted">{s.headline}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Other tiers</p>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {others.map((p) => (
            <a href={`/products/${p.slug}/`} class="glass glass-hover flex gap-4 rounded-2xl p-4">
              <img
                src={p.hero}
                alt=""
                class="h-20 w-28 shrink-0 rounded-xl object-cover"
                loading="lazy"
              />
              <div>
                <p class="font-mono text-[11px] text-wave-violet">{p.model}</p>
                <h3 class="font-semibold text-ink">{p.title}</h3>
                <p class="mt-1 line-clamp-2 text-xs text-muted">{p.headline}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <div id="contact">
    <CtaBand
      title={`Configure ${product.model} for your site`}
      body="Tell us vehicle mix, power limits, and deployment timeline. We will map the right TAICO EV hardware tier."
      label="Talk to a product specialist"
    />
  </div>
</Layout>
