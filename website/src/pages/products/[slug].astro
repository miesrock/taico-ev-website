---
import CtaBand from "../../components/CtaBand.astro";
import WaveField from "../../components/WaveField.astro";
import Layout from "../../layouts/Layout.astro";
import { getProduct, getProductSeo, getProductSpecs, getProductStructuredData, getPublishedProducts, productCategories } from "../../data/products";
import { solutions } from "../../data/solutions";

export function getStaticPaths() {
  return getPublishedProducts().map((product) => ({ params: { slug: product.slug } }));
}

const product = getProduct(Astro.params.slug!);
if (!product) throw new Error(`Unknown product: ${Astro.params.slug}`);

const specifications = getProductSpecs(product);
const seo = getProductSeo(product);
const structuredData = getProductStructuredData(product, Astro.site ?? "https://taicoev.com");
const relatedSolutions = solutions.filter((solution) => product.solutionSlugs.includes(solution.slug));
const relatedProducts = getPublishedProducts().filter(
  (item) => item.category === product.category && item.slug !== product.slug,
);
---

<Layout title={seo.title} description={seo.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <section class="relative overflow-hidden">
    <WaveField intensity="mid" />
    <div class="section-pad relative z-10 !pt-16 !pb-10">
      <a href="/products/" class="font-mono text-xs uppercase tracking-[0.18em] text-faint transition hover:text-wave-cyan">← All products</a>
      <div class="mt-8 grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="label-tech">{productCategories.find((category) => category.slug === product.category)?.title}</p>
          <p class="mt-4 font-mono text-sm text-wave-violet">{product.model}</p>
          <h1 class="font-display mt-2 text-3xl font-semibold tracking-wide text-ink sm:text-4xl"><span class="text-gradient">{product.productType}</span></h1>
          <p class="mt-4 max-w-xl text-muted leading-relaxed">{product.summary}</p>
          <p class="mt-6 font-mono text-lg text-wave-cyan">{product.capacityKwh} kWh · {product.outputPowerKw} kW</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn-primary" href="#contact">Request configuration</a>
            <a class="btn-ghost" href="#specifications">View specifications</a>
          </div>
          <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.14em] text-faint">TAICO MC 2026 Catalog v{product.catalogSource.version} · Page {product.catalogSource.page}</p>
        </div>
        <figure class="glass overflow-hidden rounded-3xl p-3">
          <img src={product.hero} alt={`${product.model} from the TAICO product catalog`} class="h-auto w-full rounded-2xl object-contain" loading="eager" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section-pad !py-12">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="glass rounded-3xl p-6">
        <p class="label-tech">Catalog use cases</p>
        <ul class="mt-4 space-y-3">
          {product.catalogApplications.map((application) => <li class="flex gap-3 text-sm text-muted"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-wave-cyan"></span>{application}</li>)}
        </ul>
      </div>
      <div class="glass rounded-3xl p-6">
        <p class="label-tech">Published capabilities</p>
        <ul class="mt-4 space-y-3">
          {product.capabilities.map((capability) => <li class="flex gap-3 text-sm text-muted"><span class="font-mono text-wave-mint">+</span>{capability}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="specifications" class="section-pad !pt-0">
    <div class="glass overflow-hidden rounded-3xl">
      <div class="border-b border-line px-6 py-5 sm:px-8">
        <p class="label-tech">Catalog specification</p>
        <h2 class="font-display mt-2 text-2xl font-semibold tracking-wide text-ink">Technical details</h2>
        <p class="mt-3 text-sm text-muted">Published from TAICO MC 2026 Catalog v{product.catalogSource.version}, page {product.catalogSource.page}.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[520px] text-left text-sm">
          <tbody>
            {specifications.map((specification, index) => <tr class:list={[index % 2 === 0 ? "bg-void/30" : "bg-transparent"]}><th class="w-[42%] px-6 py-3 font-medium text-muted sm:px-8">{specification.label}</th><td class="px-6 py-3 text-ink sm:px-8">{specification.value}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <p class="label-tech">Catalog application imagery</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Application reference</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">This catalog image illustrates the published application context. Final configuration must be confirmed for the project.</p>
      </div>
      <figure class="glass overflow-hidden rounded-3xl p-3"><img src={product.applicationImage} alt={`${product.model} catalog application reference`} class="h-auto w-full rounded-2xl object-contain" loading="lazy" /></figure>
    </div>
  </section>

  {
    relatedSolutions.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Explore by challenge</p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {relatedSolutions.map((solution) => <a href={`/solutions/${solution.slug}/`} class="glass glass-hover rounded-2xl p-5"><h2 class="font-semibold text-ink">{solution.title}</h2><p class="mt-2 text-sm text-muted">{solution.headline}</p></a>)}
        </div>
      </section>
    )
  }

  {
    relatedProducts.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Related products</p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {relatedProducts.map((item) => <a href={`/products/${item.slug}/`} class="glass glass-hover flex gap-4 rounded-2xl p-4"><img src={item.hero} alt="" class="h-20 w-24 shrink-0 rounded-xl object-contain" loading="lazy" /><div><p class="font-mono text-xs text-wave-cyan">{item.model}</p><h2 class="mt-1 text-sm font-semibold text-ink">{item.productType}</h2><p class="mt-1 text-xs text-muted">{item.capacityKwh} kWh · {item.outputPowerKw} kW</p></div></a>)}
        </div>
      </section>
    )
  }

  <div id="contact"><CtaBand title={`Configure ${product.model} for your project`} body="Share your vehicle, charging, power, and deployment requirements with the TAICO EV team." /></div>
</Layout>
