---
import CtaBand from "../../components/CtaBand.astro";
import PageHero from "../../components/PageHero.astro";
import Layout from "../../layouts/Layout.astro";
import { getPublishedFamilies } from "../../data/families";
import { getPublishedProducts } from "../../data/products";

const products = getPublishedProducts();
const groups = getPublishedFamilies().map((family) => ({
  ...family,
  products: products.filter((product) => product.category === family.slug),
}));
---

<Layout title="Products | TAICO EV" description="TAICO EV mobile and stationary energy storage charging systems from the TKMC range.">
  <PageHero
    src="/products/taico-pi01-product-range-group.webp"
    alt="TAICO product range group showing mobile charging, charging robot, mobile power, and stationary charging formats"
    caption="Catalog product photography, not a customer project."
    imageClass="object-center"
  >
    <p class="label-tech">TKMC product range</p>
    <h1 class="font-display mt-3 text-2xl font-semibold leading-tight tracking-wide text-white sm:text-4xl">
      Energy storage charging, organized by deployment.
    </h1>
    <p class="mt-4 hidden max-w-md text-sm leading-relaxed text-white/75 lg:block">
      Compare the published TAICO MC 2026 Catalog v1.3 range by product format, capacity, and output power.
    </p>
  </PageHero>

  {
    groups.map((group) => (
      <section class="section-pad !pt-0">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <a href={`/products/category/${group.slug}/`} class="label-tech transition hover:text-wave-cyan">{group.title} →</a>
            <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">{group.description}</h2>
          </div>
        </div>
        <div class="mt-7 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
          {
            group.products.map((product) => (
              <a href={`/products/${product.slug}/`} class="glass glass-hover group flex flex-col overflow-hidden rounded-3xl">
                <div class="aspect-[16/10] bg-void-2 p-3">
                  <img src={product.hero} alt={`${product.model} product`} class="h-full w-full object-contain" loading="lazy" />
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <p class="font-mono text-[11px] text-wave-violet">{product.model}</p>
                  <h3 class="mt-2 text-lg font-semibold text-ink transition group-hover:text-wave-cyan">{product.productType}</h3>
                  <p class="mt-3 text-sm text-muted">{product.summary}</p>
                  <p class="mt-5 font-mono text-sm text-wave-cyan">{product.capacityKwh} kWh · {product.outputPowerKw} kW</p>
                  <span class="mt-5 text-sm font-semibold text-wave-cyan">View specifications →</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    ))
  }

  <CtaBand title="Need help comparing the TKMC range?" body="Share your operating scenario and required charging capacity. We will help identify a starting configuration." />
</Layout>
