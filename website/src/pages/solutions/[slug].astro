---
import CtaBand from "../../components/CtaBand.astro";
import WaveField from "../../components/WaveField.astro";
import Layout from "../../layouts/Layout.astro";
import { getProductsForSolution } from "../../data/products";
import { contactHref } from "../../data/site";
import { getSolution, solutions } from "../../data/solutions";

export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug } }));
}

const solution = getSolution(Astro.params.slug!);
if (!solution) throw new Error(`Unknown solution: ${Astro.params.slug}`);

const products = getProductsForSolution(solution.slug);
const otherSolutions = solutions.filter((item) => item.slug !== solution.slug);
const solutionContact = contactHref({ source: "solution-detail", solution: solution.slug, page: Astro.url.pathname });
---

<Layout title={`${solution.title} | TAICO EV`} description={solution.summary}>
  <section class="relative overflow-hidden">
    <WaveField intensity="mid" />
    <div class="section-pad relative z-10 !pt-20 !pb-16">
      <a href="/#solutions" class="font-mono text-xs uppercase tracking-[0.18em] text-faint transition hover:text-wave-cyan">← All solutions</a>
      <p class="label-tech mt-6">{solution.eyebrow}</p>
      <h1 class="font-display mt-4 max-w-3xl text-3xl font-semibold tracking-wide text-ink sm:text-5xl"><span class="text-gradient">{solution.title}</span></h1>
      <p class="mt-4 max-w-2xl text-xl text-ink/90">{solution.headline}</p>
      <p class="mt-4 max-w-2xl text-muted leading-relaxed">{solution.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3"><a class="btn-primary" href={solutionContact}>Discuss this scenario</a><a class="btn-ghost" href="/products/">View products</a></div>
    </div>
  </section>

  <section class="section-pad !py-12">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="glass rounded-3xl p-6"><p class="label-tech">Operating constraints</p><ul class="mt-5 space-y-3">{solution.pains.map((pain) => <li class="flex gap-3 text-sm text-muted"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-wave-pink"></span>{pain}</li>)}</ul></div>
      <div class="glass rounded-3xl p-6"><p class="label-tech">Configuration path</p><ol class="mt-5 space-y-4">{solution.approach.map((step, index) => <li class="flex gap-4 text-sm text-muted"><span class="font-mono text-wave-violet">{String(index + 1).padStart(2, "0")}</span>{step}</li>)}</ol></div>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="label-tech">Initial product match</p><h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Catalog-supported starting points</h2></div><p class="max-w-xl text-sm text-muted">Initial match only. Final configuration depends on vehicles, daily energy demand, site supply, and deployment requirements.</p></div>
    <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {products.map((product) => <a href={`/products/${product.slug}/`} class="glass glass-hover group overflow-hidden rounded-3xl"><div class="aspect-[16/10] bg-void-2 p-3"><img src={product.hero} alt={`${product.model} product`} class="h-full w-full object-contain" loading="lazy" /></div><div class="p-5"><p class="font-mono text-xs text-wave-cyan">{product.model}</p><h3 class="mt-2 font-semibold text-ink group-hover:text-wave-cyan">{product.productType}</h3><p class="mt-3 text-sm text-muted">{product.capacityKwh} kWh · {product.outputPowerKw} kW</p></div></a>)}
    </div>
  </section>

  <section class="section-pad !pt-0"><p class="label-tech">Other solutions</p><div class="mt-5 grid gap-4 md:grid-cols-3">{otherSolutions.map((item) => <a href={`/solutions/${item.slug}/`} class="glass glass-hover rounded-2xl p-5"><h2 class="font-semibold text-ink">{item.title}</h2><p class="mt-2 text-sm text-muted">{item.headline}</p></a>)}</div></section>

  <div id="contact"><CtaBand source="solution-detail" solution={solution.slug} pagePath={Astro.url.pathname} title={`Discuss ${solution.title}`} /></div>
</Layout>
