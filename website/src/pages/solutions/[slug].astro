---
import Layout from "../../layouts/Layout.astro";
import WaveField from "../../components/WaveField.astro";
import CtaBand from "../../components/CtaBand.astro";
import { solutions, getSolution } from "../../data/solutions";

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const solution = getSolution(slug!);

if (!solution) {
  throw new Error(`Unknown solution: ${slug}`);
}

const others = solutions.filter((s) => s.slug !== solution.slug);
---

<Layout
  title={`${solution.title} | TAICO EV`}
  description={solution.summary}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <WaveField intensity="mid" />
    <div class="section-pad relative z-10 !pt-20 !pb-16">
      <a
        href="/#solutions"
        class="font-mono text-xs uppercase tracking-[0.18em] text-faint transition hover:text-wave-cyan"
      >
        ← All solutions
      </a>
      <p class="label-tech mt-6">{solution.eyebrow}</p>
      <h1 class="font-display mt-4 max-w-3xl text-3xl font-semibold tracking-wide text-ink sm:text-5xl">
        <span class="text-gradient">{solution.title}</span>
      </h1>
      <p class="mt-4 max-w-2xl text-xl text-ink/90">{solution.headline}</p>
      <p class="mt-4 max-w-2xl text-muted leading-relaxed">{solution.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="#contact">Discuss this scenario</a>
        <a class="btn-ghost" href="/#products">View capability tiers</a>
      </div>
    </div>
  </section>

  <div class="wave-divider"></div>

  <section class="section-pad !py-14">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="glass rounded-3xl p-6 lg:col-span-1">
        <p class="label-tech">Audience</p>
        <ul class="mt-4 space-y-3">
          {
            solution.audience.map((a) => (
              <li class="flex gap-3 text-sm text-muted">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-wave-cyan" />
                {a}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="glass rounded-3xl p-6 lg:col-span-2">
        <p class="label-tech">Operating constraints</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            solution.pains.map((p) => (
              <li class="rounded-2xl border border-line bg-void/40 px-4 py-3 text-sm text-ink">
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="glass rounded-3xl p-6 sm:p-8">
        <p class="label-tech">Outcomes</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">
          What buyers actually gain
        </h2>
        <ul class="mt-6 space-y-3">
          {
            solution.outcomes.map((o) => (
              <li class="flex gap-3 text-sm text-muted">
                <span class="font-mono text-wave-mint">+</span>
                <span class="text-ink/90">{o}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="glass rounded-3xl p-6 sm:p-8">
        <p class="label-tech">Deployment path</p>
        <h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">
          How we approach the site
        </h2>
        <ol class="mt-6 space-y-4">
          {
            solution.approach.map((step, i) => (
              <li class="flex gap-4">
                <span class="font-mono text-sm text-wave-violet">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="text-sm text-muted">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="glass relative overflow-hidden rounded-3xl p-6 sm:p-8">
      <p class="label-tech">Hardware fit · Directional</p>
      <h2 class="font-display mt-3 text-xl font-semibold tracking-wide text-ink sm:text-2xl">
        Recommended product tier
      </h2>
      <p class="mt-3 max-w-2xl text-muted">{solution.productsHint}</p>
      <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
        Detailed model pages and certified datasheets · next content wave
      </p>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section-pad !pt-0">
        <p class="label-tech">Adjacent solutions</p>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {others.map((s) => (
            <a href={`/solutions/${s.slug}/`} class="glass glass-hover rounded-2xl p-5">
              <h3 class="font-semibold text-ink">{s.title}</h3>
              <p class="mt-2 text-sm text-muted">{s.headline}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <div id="contact">
    <CtaBand title={`Discuss ${solution.title}`} />
  </div>
</Layout>
