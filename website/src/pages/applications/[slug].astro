---
import CtaBand from "../../components/CtaBand.astro";
import WaveField from "../../components/WaveField.astro";
import Layout from "../../layouts/Layout.astro";
import { applications, getApplication } from "../../data/applications";
import { getProductsForApplication } from "../../data/products";
import { getSolution } from "../../data/solutions";

export function getStaticPaths() {
  return applications.map((application) => ({ params: { slug: application.slug } }));
}

const application = getApplication(Astro.params.slug!);
if (!application) throw new Error(`Unknown application: ${Astro.params.slug}`);

const products = getProductsForApplication(application.slug);
const solution = getSolution(application.solutionSlug);
---

<Layout title={`${application.title} | TAICO EV`} description={application.summary}>
  <section class="relative overflow-hidden">
    <WaveField intensity="low" />
    <div class="section-pad relative z-10 !pt-20 !pb-16">
      <a href="/applications/" class="font-mono text-xs uppercase tracking-[0.18em] text-faint transition hover:text-wave-cyan">← All applications</a>
      <p class="label-tech mt-6">{application.eyebrow}</p>
      <h1 class="font-display mt-4 max-w-3xl text-3xl font-semibold tracking-wide text-ink sm:text-5xl"><span class="text-gradient">{application.title}</span></h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{application.summary}</p>
      {solution && <a href={`/solutions/${solution.slug}/`} class="btn-ghost mt-8">Explore {solution.title}</a>}
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="label-tech">Suitable catalog products</p><h2 class="font-display mt-3 text-2xl font-semibold tracking-wide text-ink">Start from the published application fit</h2></div><p class="max-w-xl text-sm text-muted">Suitable products are an initial guide. Confirm the final system configuration with the TAICO EV team.</p></div>
    <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {products.map((product) => <a href={`/products/${product.slug}/`} class="glass glass-hover group overflow-hidden rounded-3xl"><div class="aspect-[16/10] bg-void-2 p-3"><img src={product.applicationImage} alt={`${product.model} catalog application reference`} class="h-full w-full object-contain" loading="lazy" /></div><div class="p-5"><p class="font-mono text-xs text-wave-cyan">{product.model}</p><h2 class="mt-2 font-semibold text-ink group-hover:text-wave-cyan">{product.productType}</h2><p class="mt-3 text-sm text-muted">{product.capacityKwh} kWh · {product.outputPowerKw} kW</p></div></a>)}
    </div>
  </section>

  <div id="contact"><CtaBand title={`Discuss ${application.title}`} /></div>
</Layout>
