---
import WaveField from "../../components/WaveField.astro";
import Layout from "../../layouts/Layout.astro";
import { applications } from "../../data/applications";
---

<Layout title="Applications | TAICO EV" description="Catalog-supported applications for TAICO EV TKMC energy storage charging systems.">
  <section class="relative overflow-hidden">
    <WaveField intensity="mid" />
    <div class="section-pad relative z-10">
      <p class="label-tech">Catalog application scenarios</p>
      <h1 class="font-display mt-4 max-w-3xl text-4xl font-semibold tracking-wide text-ink">Explore the TKMC range by operating application.</h1>
      <p class="mt-4 max-w-2xl text-muted">These application paths reflect TAICO MC 2026 Catalog v1.3. Final system selection remains project specific.</p>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="grid gap-6 md:grid-cols-2">
      {applications.map((application) => <a href={`/applications/${application.slug}/`} class="glass glass-hover group rounded-3xl p-6"><p class="font-mono text-[11px] uppercase tracking-[0.16em] text-wave-violet">{application.eyebrow}</p><h2 class="mt-3 text-xl font-semibold text-ink group-hover:text-wave-cyan">{application.title}</h2><p class="mt-3 text-sm leading-relaxed text-muted">{application.summary}</p><span class="mt-6 inline-block text-sm font-semibold text-wave-cyan">View suitable products →</span></a>)}
    </div>
  </section>
</Layout>
