---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | TAICO EV" description="The page you requested could not be found." robots="noindex, follow">
  <section class="section-pad">
    <div class="glass mx-auto max-w-3xl rounded-3xl p-8 sm:p-12">
      <p class="label-tech">Signal not found · 404</p>
      <h1 class="font-display mt-5 text-4xl font-semibold tracking-wide text-ink sm:text-5xl"><span class="text-gradient">Page not found.</span></h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">This route is not part of the current TAICO EV site. Start from the homepage or browse the catalog-supported sections below.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/">Back to home</a>
        <a class="btn-ghost" href="/#solutions">Explore solutions</a>
        <a class="btn-ghost" href="/products/">View products</a>
      </div>
    </div>
  </section>
</Layout>
