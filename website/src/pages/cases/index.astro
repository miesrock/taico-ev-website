---
import Layout from "../../layouts/Layout.astro";
import WaveField from "../../components/WaveField.astro";
import CtaBand from "../../components/CtaBand.astro";
import { cases } from "../../data/cases";
---

<Layout
  title="Case Studies | TAICO EV"
  description="Field application case studies for dealership charging, roadside EV rescue, commercial parking, and construction energy hubs."
>
  <section class="relative overflow-hidden">
    <WaveField intensity="mid" />
    <div class="section-pad relative z-10">
      <p class="label-tech">Field applications</p>
      <h1 class="font-display mt-4 max-w-3xl text-4xl font-semibold tracking-wide text-ink">
        <span class="text-gradient">Cases as trust assets</span> — not decoration.
      </h1>
      <p class="mt-4 max-w-2xl text-muted">
        Each page documents customer type, region, problem, equipment, deployment path, and operational outcomes.
        Photorealistic scene visuals show product form factors in real-world contexts.
      </p>
    </div>
  </section>

  <section class="section-pad !pt-0">
    <div class="grid gap-6 md:grid-cols-2">
      {
        cases.map((c) => (
          <a
            href={`/cases/${c.slug}/`}
            class="glass glass-hover group flex flex-col overflow-hidden rounded-3xl"
          >
            <div class="aspect-[16/10] overflow-hidden bg-void-2">
              <img
                src={c.hero}
                alt={c.title}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-wave-violet">
                {c.eyebrow}
              </p>
              <p class="mt-2 text-xs text-faint">
                {c.region} · {c.customerType}
              </p>
              <h2 class="mt-2 text-xl font-semibold text-ink group-hover:text-wave-cyan">
                {c.title}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{c.summary}</p>
              <span class="mt-6 text-sm font-semibold text-wave-cyan">Open case →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand
    title="Have a site we should document next?"
    body="Share region, customer type, and deployment constraints. Verified cases with measurable outcomes get full attribution when approved."
  />
</Layout>
