---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { keywordTargets, scoreKeywordCoverage } from "../../data/seo-preview";

const articles = (await getCollection("articles")).sort((a, b) => a.data.order - b.data.order);
const articleStats = articles.map((article) => {
  const pageText = [
    article.data.title,
    article.data.description,
    article.data.quickAnswer,
    article.body,
    ...article.data.faq.flatMap((item) => [item.question, item.answer]),
  ].filter(Boolean).join(" ");
  const targets = keywordTargets
    .filter((target) => target.supportingArticleSlug === article.id)
    .map((target) => ({ ...target, coverage: scoreKeywordCoverage(target.query, pageText) }));

  return {
    slug: article.id,
    title: article.data.title,
    words: article.body.trim().split(/\s+/).filter(Boolean).length,
    h2s: (article.body.match(/^##\s+/gm) ?? []).length,
    internalLinks: (article.body.match(/\]\(\/[^)]+\)/g) ?? []).length,
    faqs: article.data.faq.length,
    figures: Number(Boolean(article.data.hero)) + Number(Boolean(article.data.figure)),
    targets,
  };
});

const allTargets = articleStats.flatMap((article) => article.targets.map((target) => ({ ...target, article })));
const coverageCounts = Object.fromEntries(["exact", "strong", "partial", "gap"].map((status) => [
  status,
  allTargets.filter((target) => target.coverage.status === status).length,
])) as Record<"exact" | "strong" | "partial" | "gap", number>;
const supportedCount = coverageCounts.exact + coverageCounts.strong;
const totalWords = articleStats.reduce((sum, article) => sum + article.words, 0);

const statusClass = {
  exact: "border-wave-cyan/40 bg-wave-cyan/10 text-wave-cyan",
  strong: "border-emerald-400/40 bg-emerald-400/10 text-emerald-300",
  partial: "border-amber-400/40 bg-amber-400/10 text-amber-300",
  gap: "border-rose-400/40 bg-rose-400/10 text-rose-300",
};
---

<Layout
  title="SEO coverage preview | TAICO EV"
  description="Internal preview of article structure and long-tail keyword coverage."
  robots="noindex, nofollow"
>
  <section class="section-pad">
    <div class="mx-auto max-w-6xl">
      <p class="label-tech">Internal preview · noindex</p>
      <h1 class="mt-5 max-w-4xl font-display text-4xl font-semibold tracking-wide text-ink sm:text-5xl">Article SEO coverage</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">This page measures content structure and target-query wording. It does not report Google impressions, positions, indexing, or traffic; those require live Search Console data after deployment.</p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="glass rounded-2xl p-5"><p class="label-tech">Articles</p><p class="mt-3 text-3xl font-semibold text-ink">{articleStats.length}</p></div>
        <div class="glass rounded-2xl p-5"><p class="label-tech">Body words</p><p class="mt-3 text-3xl font-semibold text-ink">{totalWords.toLocaleString("en-US")}</p></div>
        <div class="glass rounded-2xl p-5"><p class="label-tech">Target queries</p><p class="mt-3 text-3xl font-semibold text-ink">{allTargets.length}</p></div>
        <div class="glass rounded-2xl p-5"><p class="label-tech">Article support</p><p class="mt-3 text-3xl font-semibold text-ink">{supportedCount}<span class="text-base text-muted"> / {allTargets.length}</span></p></div>
      </div>

      <section class="mt-12" aria-labelledby="article-health">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><p class="label-tech">Structure</p><h2 id="article-health" class="mt-3 font-display text-2xl font-semibold text-ink">Article health</h2></div>
          <p class="text-sm text-muted">Counts come directly from the Markdown collection.</p>
        </div>
        <div class="mt-6 grid gap-5 lg:grid-cols-3">
          {articleStats.map((article) => <article class="glass rounded-2xl p-6">
            <h3 class="text-lg font-semibold leading-snug text-ink">{article.title}</h3>
            <a class="mt-2 block break-all text-xs text-wave-cyan hover:underline" href={`/resources/articles/${article.slug}/`}>/resources/articles/{article.slug}/</a>
            <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
              <div><dt class="text-faint">Words</dt><dd class="mt-1 font-semibold text-ink">{article.words}</dd></div>
              <div><dt class="text-faint">H2 sections</dt><dd class="mt-1 font-semibold text-ink">{article.h2s}</dd></div>
              <div><dt class="text-faint">Internal links</dt><dd class="mt-1 font-semibold text-ink">{article.internalLinks}</dd></div>
              <div><dt class="text-faint">FAQ / figures</dt><dd class="mt-1 font-semibold text-ink">{article.faqs} / {article.figures}</dd></div>
            </dl>
          </article>)}
        </div>
      </section>

      <section class="mt-12" aria-labelledby="keyword-coverage">
        <p class="label-tech">Query map</p>
        <h2 id="keyword-coverage" class="mt-3 font-display text-2xl font-semibold text-ink">Long-tail coverage preview</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">Exact means the normalized phrase appears in its supporting article. Strong and partial are token-overlap checks, not ranking predictions or proof that Google considers two phrases semantically equivalent. Commercial product queries remain owned by product or solution pages to avoid cannibalization.</p>
        <div class="mt-6 space-y-3">
          {allTargets.map((target) => <article class="glass grid gap-3 rounded-2xl p-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
            <div class="min-w-0">
              <h3 class="font-semibold text-ink">{target.query}</h3>
              <p class="mt-1 break-all text-xs text-faint">Target owner: {target.ownerPath} · supporting article: {target.supportingArticleSlug}</p>
            </div>
            <div class="flex items-center gap-3">
              <span class={`rounded-full border px-3 py-1 font-mono text-xs uppercase tracking-wide ${statusClass[target.coverage.status]}`}>{target.coverage.status}</span>
              <span class="w-14 text-right font-mono text-xs text-muted">{Math.round(target.coverage.ratio * 100)}%</span>
            </div>
          </article>)}
        </div>
      </section>

      <section class="mt-12 glass rounded-3xl p-6 sm:p-8" aria-labelledby="benchmark-gap">
        <p class="label-tech">Competitor snapshot · 2026-08-24</p>
        <h2 id="benchmark-gap" class="mt-3 font-display text-2xl font-semibold text-ink">What the GSL sample does differently</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="font-semibold text-ink">TAICO already has</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
              <li>One clear query owner per article</li>
              <li>Quick answers, generated contents navigation, FAQ schema, figures, captions, and specific CTAs</li>
              <li>Catalog-backed claims and safer qualification language</li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-ink">Largest remaining gaps</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted">
              <li>GSL's sampled guides are materially broader: roughly 1,500–3,900 extracted words versus 749–1,081 here</li>
              <li>TAICO still lacks proof-led manufacturer, fleet, cost, procurement, and project-evidence clusters</li>
              <li>The new routes must be deployed, submitted, crawled, and measured before ranking claims are possible</li>
            </ul>
          </div>
        </div>
      </section>
    </div>
  </section>
</Layout>
