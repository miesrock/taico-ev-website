---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Inquiry received | TAICO EV" description="Your TAICO EV inquiry has been received." robots="noindex, nofollow">
  <section class="section-pad">
    <div class="glass mx-auto max-w-3xl rounded-3xl p-8 sm:p-12">
      <p class="label-tech">Signal received</p>
      <h1 class="font-display mt-5 text-4xl font-semibold tracking-wide text-ink sm:text-5xl"><span class="text-gradient">Thank you.</span></h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">Your inquiry has been saved and sent to the TAICO EV team for review. We usually reply within one business day.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/#solutions">Explore solutions</a>
        <a class="btn-ghost" href="/products/">View products</a>
        <a class="btn-ghost" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
